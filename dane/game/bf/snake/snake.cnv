OBJECT=LASTKEY
LASTKEY:TYPE=INTEGER
LASTKEY:VALUE=0

OBJECT=KEYBOARD
KEYBOARD:TYPE=KEYBOARD
KEYBOARD:ONKEYDOWN^W={}
KEYBOARD:ONKEYDOWN^S={}
KEYBOARD:ONKEYDOWN^A={}
KEYBOARD:ONKEYDOWN^D={}

OBJECT=ARIAL14
ARIAL14:TYPE=FONT
ARIAL14:DEF_ARIAL_STANDARD_14=$COMMON\ARIAL14.FNT

OBJECT=TXTMSG
TXTMSG:TYPE=TEXT
TXTMSG:VISIBLE=TRUE
TXTMSG:HYPERTEXT=
TXTMSG:FONT=ARIAL14
TXTMSG:TOCANVAS=TRUE
TXTMSG:RECT=0,0,800,250
TXTMSG:PRIORITY=10000
TXTMSG:HJUSTIFY=CENTER
TXTMSG:VJUSTIFY=TOP
TXTMSG:MONITORCOLLISION=FALSE
TXTMSG:MONITORCOLLISIONALPHA=FALSE

OBJECT=SNAKE_BF_CODE
SNAKE_BF_CODE:TYPE=STRING
SNAKE_BF_CODE:VALUE=-[-[>+<-]>]>>>>+++[>++++++<-]>[>[>>>]+[<<<]++++[>++++<-]>[>>[>>>]+++[<<<]>-]>-]>[->>>-]+[>>>]+[-<<<-]+<--[--[<<<+>>>-]<<<]<<----<--[-----[>>>+<<<-]>>>]<<<<<<<<+[<<<]<+[<<<<<[-]>-[[<]<[-]>+[>]<-]+>+>>>>+>>>[-[<+>>>+<<-]+<[++[---[-[->[<<<]<[<]>+++[>----<-]<]>[[<<<]<[<]>-]<]>[[<<<]<[<]>>+++<-]<]>[[<<<]<[<]>>+++++<-]>+++++++[<<++++>>-]+[>]<[>>>]]+>>>[<<+>>-]>]<<<[<-<<]>>+>->--->++++++++[<+++<.[-]<<<+<,-[>--<-[<+>>+<--[<-->----[<+>[+]]]]]<[>++++>+<<-]>[>++++<-]>[>[-]<[>+<-]]>>>>>-]<<<<[>[<<+>>>+[->>>+]->+<[<<<]<-]>+[->>>+]+++[<++++++>-]++<[-[<<<+>>>-]<<<]>[<+<<]<<[<<+>>>>+<<-]>++++[>++++<-]>+[>>[>>>]+[<<<]>-]>>[->>>]+>---[-[[>>>]-[>+<-----]>+.<]<[->-[<<<]<<<+[+>>>>[<<+<<[+>]>>[-[<<->>-]>]>-]<<+[<<->>[>>>]+>---[+++>>+>---]+++[<<<]<-]+[->>>]<<+[<<<]<]-[>+<+++++++++]<[>>++.[-]]]>]<[->-[>>>]<<<[>[-[->]<+[<]<]<<<<]<<]]<[[[>>+<<-]<]>>]>>]
SNAKE_BF_CODE:DESCRIPTION=(c) 2025 Daniel B. Cristofani. http://brainfuck.org/. This program is licensed under a Creative Commons Attribution-ShareAlike 4.0 International License (http://creativecommons.org/licenses/by-sa/4.0/). Source from https://brainfuck.org/snake_explained.b, intended use in bf16 emulator.

OBJECT=TEST_BF_CODE
TEST_BF_CODE:TYPE=STRING
TEST_BF_CODE:VALUE=>>>+++++++++++++[<<<+++++>>+++++>-]<+.
TEST_BF_CODE:DESCRIPTION=Just write letter A (65) to video memory at 0 and letter B (66) at 2. Nothing special.

OBJECT=RENDER_VIDEO_BUFFER
RENDER_VIDEO_BUFFER:TYPE=BEHAVIOUR
RENDER_VIDEO_BUFFER:CODE={@LOOP("{BF_SCREEN^UPDATE_PIXEL(_I_,BF_INTERPRETER^GET_CELL(_I_));}",0,256,1);}

# bf16 shows one frame per "." at 60 FPS. FRAME_TIMER ticks less often than
# that, so each tick asks for the frames that are due since the last one
# (FRAME_ACC keeps the remainder in thousandths of a frame) and redraws once.

OBJECT=TARGET_FPS
TARGET_FPS:TYPE=INTEGER
TARGET_FPS:VALUE=60

OBJECT=MAX_FRAMES_PER_TICK
MAX_FRAMES_PER_TICK:TYPE=INTEGER
MAX_FRAMES_PER_TICK:VALUE=8

OBJECT=FRAME_NOW
FRAME_NOW:TYPE=INTEGER
FRAME_NOW:VALUE=0

OBJECT=FRAME_LAST
FRAME_LAST:TYPE=INTEGER
FRAME_LAST:VALUE=0

OBJECT=FRAME_ACC
FRAME_ACC:TYPE=INTEGER
FRAME_ACC:VALUE=0

OBJECT=FRAMES_DUE
FRAMES_DUE:TYPE=INTEGER
FRAMES_DUE:VALUE=0

OBJECT=BF_FRAME
BF_FRAME:TYPE=BEHAVIOUR
BF_FRAME:CODE={FRAME_NOW^SET(SYSTEM^GETSYSTEMTIME());FRAME_ACC^ADD([FRAME_NOW-FRAME_LAST*TARGET_FPS]);FRAME_LAST^SET(FRAME_NOW);FRAMES_DUE^SET([FRAME_ACC@1000]);FRAME_ACC^SET([FRAME_ACC%1000]);@IF("FRAMES_DUE",">","MAX_FRAMES_PER_TICK","{FRAMES_DUE^SET(MAX_FRAMES_PER_TICK);}","");@INT("BF_RENDER",BF_INTERPRETER^TICK(FRAMES_DUE));@IF("BF_RENDER",">","0","{RENDER_VIDEO_BUFFER^RUN();}","");}

OBJECT=FRAME_TIMER
FRAME_TIMER:TYPE=TIMER
FRAME_TIMER:ELAPSE=16
FRAME_TIMER:ENABLED=FALSE
FRAME_TIMER:TICKS=0
FRAME_TIMER:ONTICK={BF_FRAME^RUN();}

OBJECT=__INIT__
__INIT__:TYPE=BEHAVIOUR
#__INIT__:CODE={CLSBFOBJ^NEW("BF_INTERPRETER",SNAKE_BF_CODE);}
__INIT__:CODE={CLSSCREENOBJ^NEW("BF_SCREEN");CLSBFOBJ^NEW("BF_INTERPRETER",TEST_BF_CODE);RENDER_VIDEO_BUFFER^RUN();FRAME_LAST^SET(SYSTEM^GETSYSTEMTIME());FRAME_TIMER^ENABLE();}

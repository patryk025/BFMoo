OBJECT=TAPE
TAPE:TYPE=ARRAY

OBJECT=BRACKET_STACK
BRACKET_STACK:TYPE=ARRAY

OBJECT=BRACKET_STACK_TOP
BRACKET_STACK_TOP:TYPE=INTEGER
BRACKET_STACK_TOP:VALUE=-1

OBJECT=DEBUG_LOG
DEBUG_LOG:TYPE=STRING
DEBUG_LOG:VALUE=
DEBUG_LOG:TOINI=TRUE
DEBUG_LOG:DEFAULT=

OBJECT=JUMP_TABLE
JUMP_TABLE:TYPE=ARRAY

OBJECT=TAPE_SIZE
TAPE_SIZE:TYPE=INTEGER
TAPE_SIZE:VALUE=30000

OBJECT=VIDEO_MEMORY_SIZE
VIDEO_MEMORY_SIZE:TYPE=INTEGER
VIDEO_MEMORY_SIZE:VALUE=256

OBJECT=TP
TP:TYPE=INTEGER
TP:VALUE=0

OBJECT=IP
IP:TYPE=INTEGER
IP:VALUE=0

OBJECT=PROGRAM_LENGTH
PROGRAM_LENGTH:TYPE=INTEGER
PROGRAM_LENGTH:VALUE=0

OBJECT=STEP_BUDGET
STEP_BUDGET:TYPE=INTEGER
STEP_BUDGET:VALUE=5000

OBJECT=RUNNING
RUNNING:TYPE=INTEGER
RUNNING:VALUE=0

OBJECT=YIELDED
YIELDED:TYPE=INTEGER
YIELDED:VALUE=0

OBJECT=RENDER_REQUESTED
RENDER_REQUESTED:TYPE=INTEGER
RENDER_REQUESTED:VALUE=0

OBJECT=VALID_PROGRAM
VALID_PROGRAM:TYPE=INTEGER
VALID_PROGRAM:VALUE=1

OBJECT=LAST_DEBUG_VALUE
LAST_DEBUG_VALUE:TYPE=INTEGER
LAST_DEBUG_VALUE:VALUE=0

OBJECT=CURRENT_INSTR
CURRENT_INSTR:TYPE=STRING
CURRENT_INSTR:VALUE=

OBJECT=ERROR_CODE
ERROR_CODE:TYPE=STRING
ERROR_CODE:VALUE=

OBJECT=BF_CODE
BF_CODE:TYPE=STRING
BF_CODE:VALUE=
BF_CODE:ONBRUTALCHANGED={PROGRAM_LENGTH^SET(BF_CODE^LENGTH());}

#
# BRAINFUCK SYMBOLS
#

OBJECT=INCREMENT_POINTER_CHAR
INCREMENT_POINTER_CHAR:TYPE=STRING
INCREMENT_POINTER_CHAR:VALUE=>

OBJECT=DECREMENT_POINTER_CHAR
DECREMENT_POINTER_CHAR:TYPE=STRING
DECREMENT_POINTER_CHAR:VALUE=<

OBJECT=INCREMENT_VALUE_CHAR
INCREMENT_VALUE_CHAR:TYPE=STRING
INCREMENT_VALUE_CHAR:VALUE=+

OBJECT=DECREMENT_VALUE_CHAR
DECREMENT_VALUE_CHAR:TYPE=STRING
DECREMENT_VALUE_CHAR:VALUE=-

OBJECT=OUTPUT_CHAR
OUTPUT_CHAR:TYPE=STRING
OUTPUT_CHAR:VALUE=.

OBJECT=INPUT_CHAR
INPUT_CHAR:TYPE=STRING
INPUT_CHAR:VALUE=,

OBJECT=OPEN_LOOP_CHAR
OPEN_LOOP_CHAR:TYPE=STRING
OPEN_LOOP_CHAR:VALUE=[

OBJECT=CLOSE_LOOP_CHAR
CLOSE_LOOP_CHAR:TYPE=STRING
CLOSE_LOOP_CHAR:VALUE=]

OBJECT=DEBUG_CHAR
DEBUG_CHAR:TYPE=STRING
DEBUG_CHAR:VALUE=?

#
# INITIALIZATION AND PREPROCESSING
#

OBJECT=INITIALIZE_TAPE
INITIALIZE_TAPE:TYPE=BEHAVIOUR
INITIALIZE_TAPE:CODE={TAPE^LOAD("$COMMON\bf_tape_30000.arr");}

OBJECT=INITIALIZE_JUMP_TABLE
INITIALIZE_JUMP_TABLE:TYPE=BEHAVIOUR
INITIALIZE_JUMP_TABLE:CODE={JUMP_TABLE^REMOVEALL();@LOOP("{JUMP_TABLE^ADD(-1);}",0,PROGRAM_LENGTH,1);}

OBJECT=MATCH_CLOSE_BRACKET
MATCH_CLOSE_BRACKET:TYPE=BEHAVIOUR
MATCH_CLOSE_BRACKET:CODE={@IF("BRACKET_STACK_TOP","<","0","{VALID_PROGRAM^SET(0);ERROR_CODE^SET("UNMATCHED_CLOSE_AT_");ERROR_CODE^ADD($1);}","{@INT("OPEN_ADDRESS",BRACKET_STACK^GET(BRACKET_STACK_TOP));BRACKET_STACK^REMOVEAT(BRACKET_STACK_TOP);BRACKET_STACK_TOP^DEC();JUMP_TABLE^CHANGEAT(OPEN_ADDRESS,$1);JUMP_TABLE^CHANGEAT($1,OPEN_ADDRESS);}");}

OBJECT=PREPROCESS_CHAR
PREPROCESS_CHAR:TYPE=BEHAVIOUR
PREPROCESS_CHAR:CODE={@STRING("PREPROCESS_INSTR",BF_CODE^GET($1));@IF("PREPROCESS_INSTR","_","OPEN_LOOP_CHAR","{BRACKET_STACK^ADD($1);BRACKET_STACK_TOP^INC();}","");@IF("PREPROCESS_INSTR","_","CLOSE_LOOP_CHAR","{MATCH_CLOSE_BRACKET^RUN($1);}","");}

OBJECT=PREPROCESS_CODE
PREPROCESS_CODE:TYPE=BEHAVIOUR
PREPROCESS_CODE:CODE={VALID_PROGRAM^SET(1);ERROR_CODE^SET("");BRACKET_STACK^REMOVEALL();BRACKET_STACK_TOP^SET(-1);INITIALIZE_JUMP_TABLE^RUN();@LOOP("{PREPROCESS_CHAR^RUN(_I_);}",0,PROGRAM_LENGTH,1);@IF("BRACKET_STACK_TOP",">_","0","{VALID_PROGRAM^SET(0);ERROR_CODE^SET("UNMATCHED_OPEN_AT_");ERROR_CODE^ADD(BRACKET_STACK^GET(BRACKET_STACK_TOP));}","");}

#
# VM OPERATIONS
#

OBJECT=MOVE_RIGHT
MOVE_RIGHT:TYPE=BEHAVIOUR
MOVE_RIGHT:CODE={TP^INC();@IF("TP",">_","TAPE_SIZE","{TP^SET(0);}","");}

OBJECT=MOVE_LEFT
MOVE_LEFT:TYPE=BEHAVIOUR
MOVE_LEFT:CODE={TP^DEC();@IF("TP","<","0","{TP^ADD(TAPE_SIZE);}","");}

OBJECT=INCREMENT_VALUE
INCREMENT_VALUE:TYPE=BEHAVIOUR
INCREMENT_VALUE:CODE={@INT("NEXT_VALUE",[TAPE^GET(TP)+1]);@IF("NEXT_VALUE",">","255","{NEXT_VALUE^SET(0);}","");TAPE^CHANGEAT(TP,NEXT_VALUE);}

OBJECT=DECREMENT_VALUE
DECREMENT_VALUE:TYPE=BEHAVIOUR
DECREMENT_VALUE:CODE={@INT("NEXT_VALUE",[TAPE^GET(TP)-1]);@IF("NEXT_VALUE","<","0","{NEXT_VALUE^SET(255);}","");TAPE^CHANGEAT(TP,NEXT_VALUE);}

OBJECT=JUMP_FORWARD
JUMP_FORWARD:TYPE=BEHAVIOUR
JUMP_FORWARD:CODE={@IF("TAPE^GET(TP)","_","0","{IP^SET(JUMP_TABLE^GET(IP));}","");}

OBJECT=JUMP_BACKWARD
JUMP_BACKWARD:TYPE=BEHAVIOUR
JUMP_BACKWARD:CODE={@IF("TAPE^GET(TP)","!_","0","{IP^SET(JUMP_TABLE^GET(IP));}","");}

OBJECT=READ_INPUT
READ_INPUT:TYPE=BEHAVIOUR
READ_INPUT:CODE={@INT("KEY_MASK",0);@IF(KEYBOARD^ISKEYDOWN("Z"),"_",TRUE,"{KEY_MASK^ADD(128);}","");@IF(KEYBOARD^ISKEYDOWN("X"),"_",TRUE,"{KEY_MASK^ADD(64);}","");@IF(KEYBOARD^ISKEYDOWN("ENTER"),"_",TRUE,"{KEY_MASK^ADD(32);}","");@IF(KEYBOARD^ISKEYDOWN("SPACE"),"_",TRUE,"{KEY_MASK^ADD(16);}","");@IF(KEYBOARD^ISKEYDOWN("UP"),"_",TRUE,"{KEY_MASK^ADD(8);}","");@IF(KEYBOARD^ISKEYDOWN("DOWN"),"_",TRUE,"{KEY_MASK^ADD(4);}","");@IF(KEYBOARD^ISKEYDOWN("LEFT"),"_",TRUE,"{KEY_MASK^ADD(2);}","");@IF(KEYBOARD^ISKEYDOWN("RIGHT"),"_",TRUE,"{KEY_MASK^ADD(1);}","");TAPE^CHANGEAT(TP,KEY_MASK);}

OBJECT=EXECUTE_INSTRUCTION
EXECUTE_INSTRUCTION:TYPE=BEHAVIOUR
EXECUTE_INSTRUCTION:CODE={@IF("CURRENT_INSTR","_","INCREMENT_POINTER_CHAR","{MOVE_RIGHT^RUN();}","");@IF("CURRENT_INSTR","_","DECREMENT_POINTER_CHAR","{MOVE_LEFT^RUN();}","");@IF("CURRENT_INSTR","_","INCREMENT_VALUE_CHAR","{INCREMENT_VALUE^RUN();}","");@IF("CURRENT_INSTR","_","DECREMENT_VALUE_CHAR","{DECREMENT_VALUE^RUN();}","");@IF("CURRENT_INSTR","_","OPEN_LOOP_CHAR","{JUMP_FORWARD^RUN();}","");@IF("CURRENT_INSTR","_","CLOSE_LOOP_CHAR","{JUMP_BACKWARD^RUN();}","");@IF("CURRENT_INSTR","_","INPUT_CHAR","{READ_INPUT^RUN();}","");@IF("CURRENT_INSTR","_","OUTPUT_CHAR","{RENDER_REQUESTED^SET(1);YIELDED^SET(1);}","");@IF("CURRENT_INSTR","_","DEBUG_CHAR","{LAST_DEBUG_VALUE^SET(TAPE^GET(TP));}","");IP^INC();}

#
# FRAME LOOP
#
# CLSBFOBJ is declared in the episode (bf.cnv), so this instance resolves names
# in the episode and the application only. BF_SCREEN is created by the scene and
# lives there, out of reach. The scene owns the timer and the renderer instead:
# it calls TICK every frame and reads the video memory through GET_CELL.

OBJECT=GET_CELL
GET_CELL:TYPE=BEHAVIOUR
GET_CELL:CODE={@RETURN(TAPE^GET($1));}

OBJECT=RUN_SLICE
RUN_SLICE:TYPE=BEHAVIOUR
RUN_SLICE:CODE={YIELDED^SET(0);@INT("STEPS",0);@WHILE("YIELDED","_","0","{@IF("IP","<","PROGRAM_LENGTH","{CURRENT_INSTR^SET(BF_CODE^GET(IP));EXECUTE_INSTRUCTION^RUN();STEPS^INC();@IF("STEPS",">_","STEP_BUDGET","{YIELDED^SET(1);}","");}","{RUNNING^SET(0);YIELDED^SET(1);}");}");}

# Runs until the next "." (or the step budget) and returns 1 when the scene should redraw.
OBJECT=TICK
TICK:TYPE=BEHAVIOUR
TICK:CODE={RENDER_REQUESTED^SET(0);@IF("RUNNING","_","1","{RUN_SLICE^RUN();}","");@RETURN(RENDER_REQUESTED);}

OBJECT=IS_RUNNING
IS_RUNNING:TYPE=BEHAVIOUR
IS_RUNNING:CODE={@RETURN(RUNNING);}

OBJECT=START_BF
START_BF:TYPE=BEHAVIOUR
START_BF:CODE={RUNNING^SET(0);YIELDED^SET(0);RENDER_REQUESTED^SET(0);IP^SET(0);TP^SET(0);INITIALIZE_TAPE^RUN();PREPROCESS_CODE^RUN();DEBUG_LOG^SET(ERROR_CODE);@IF("VALID_PROGRAM","_","1","{RUNNING^SET(1);}","");}

OBJECT=STOP_BF
STOP_BF:TYPE=BEHAVIOUR
STOP_BF:CODE={RUNNING^SET(0);}

OBJECT=CONSTRUCTOR
CONSTRUCTOR:TYPE=BEHAVIOUR
CONSTRUCTOR:CODE={BF_CODE^SET($2);START_BF^RUN();}

OBJECT=DESTRUCTOR
DESTRUCTOR:TYPE=BEHAVIOUR
DESTRUCTOR:CODE={STOP_BF^RUN();}

OBJECT=TAPE
TAPE:TYPE=ARRAY

OBJECT=BRACKET_STACK
BRACKET_STACK:TYPE=ARRAY

OBJECT=BRACKET_STACK_TOP
BRACKET_STACK_TOP:TYPE=INTEGER
BRACKET_STACK_TOP:VALUE=-1

OBJECT=DEBUG_LOG
DEBUG_LOG:TYPE=STRING
DEBUG_LOG:VALUE=
DEBUG_LOG:TOINI=TRUE
DEBUG_LOG:DEFAULT=

OBJECT=TAPE_SIZE
TAPE_SIZE:TYPE=INTEGER
TAPE_SIZE:VALUE=30000

OBJECT=VIDEO_MEMORY_SIZE
VIDEO_MEMORY_SIZE:TYPE=INTEGER
VIDEO_MEMORY_SIZE:VALUE=256

OBJECT=TP
TP:TYPE=INTEGER
TP:VALUE=0

OBJECT=IP
IP:TYPE=INTEGER
IP:VALUE=0

OBJECT=PROGRAM_LENGTH
PROGRAM_LENGTH:TYPE=INTEGER
PROGRAM_LENGTH:VALUE=0

OBJECT=STEP_BUDGET
STEP_BUDGET:TYPE=INTEGER
STEP_BUDGET:VALUE=15000

OBJECT=STEPS
STEPS:TYPE=INTEGER
STEPS:VALUE=0

OBJECT=HALTED
HALTED:TYPE=INTEGER
HALTED:VALUE=0

OBJECT=RESUME_IP
RESUME_IP:TYPE=INTEGER
RESUME_IP:VALUE=0

OBJECT=RUNNING
RUNNING:TYPE=INTEGER
RUNNING:VALUE=0

OBJECT=RENDER_REQUESTED
RENDER_REQUESTED:TYPE=INTEGER
RENDER_REQUESTED:VALUE=0

OBJECT=VALID_PROGRAM
VALID_PROGRAM:TYPE=INTEGER
VALID_PROGRAM:VALUE=1

OBJECT=LAST_DEBUG_VALUE
LAST_DEBUG_VALUE:TYPE=INTEGER
LAST_DEBUG_VALUE:VALUE=0

OBJECT=ERROR_CODE
ERROR_CODE:TYPE=STRING
ERROR_CODE:VALUE=

OBJECT=BF_CODE
BF_CODE:TYPE=STRING
BF_CODE:VALUE=
BF_CODE:ONBRUTALCHANGED={PROGRAM_LENGTH^SET(BF_CODE^LENGTH());}

#
# BRAINFUCK SYMBOLS
#

OBJECT=INCREMENT_POINTER_CHAR
INCREMENT_POINTER_CHAR:TYPE=STRING
INCREMENT_POINTER_CHAR:VALUE=>

OBJECT=DECREMENT_POINTER_CHAR
DECREMENT_POINTER_CHAR:TYPE=STRING
DECREMENT_POINTER_CHAR:VALUE=<

OBJECT=INCREMENT_VALUE_CHAR
INCREMENT_VALUE_CHAR:TYPE=STRING
INCREMENT_VALUE_CHAR:VALUE=+

OBJECT=DECREMENT_VALUE_CHAR
DECREMENT_VALUE_CHAR:TYPE=STRING
DECREMENT_VALUE_CHAR:VALUE=-

OBJECT=OUTPUT_CHAR
OUTPUT_CHAR:TYPE=STRING
OUTPUT_CHAR:VALUE=.

OBJECT=INPUT_CHAR
INPUT_CHAR:TYPE=STRING
INPUT_CHAR:VALUE=,

OBJECT=OPEN_LOOP_CHAR
OPEN_LOOP_CHAR:TYPE=STRING
OPEN_LOOP_CHAR:VALUE=[

OBJECT=CLOSE_LOOP_CHAR
CLOSE_LOOP_CHAR:TYPE=STRING
CLOSE_LOOP_CHAR:VALUE=]

OBJECT=DEBUG_CHAR
DEBUG_CHAR:TYPE=STRING
DEBUG_CHAR:VALUE=?

#
# COMPILED PROGRAM
#
# The source is compiled once into two parallel arrays: OPS holds the name of
# the behaviour that executes each operation, ARGS its argument. Runs of +/-
# and >/< collapse into one OP_ADD/OP_MOVE, [-] and [+] become OP_CLEAR, and
# OP_JZ/OP_JNZ carry the distance to their matching bracket. The VM then calls
# *OPNAME^RUN() instead of testing the instruction against every symbol.

OBJECT=OPS
OPS:TYPE=ARRAY

OBJECT=ARGS
ARGS:TYPE=ARRAY

OBJECT=OP_COUNT
OP_COUNT:TYPE=INTEGER
OP_COUNT:VALUE=0

OBJECT=OPNAME
OPNAME:TYPE=STRING
OPNAME:VALUE=

# IS_ZERO[v] and IS_NONZERO[v] for v = 0..255: jumps multiply their relative
# target by these instead of using @IF, which costs ten times more.
OBJECT=IS_ZERO
IS_ZERO:TYPE=ARRAY

OBJECT=IS_NONZERO
IS_NONZERO:TYPE=ARRAY

OBJECT=ADD_OP_NAME
ADD_OP_NAME:TYPE=STRING
ADD_OP_NAME:VALUE=OP_ADD

OBJECT=MOVE_OP_NAME
MOVE_OP_NAME:TYPE=STRING
MOVE_OP_NAME:VALUE=OP_MOVE

# OP_COUNT-OPEN, name of the body op and its argument squared: "2OP_ADD1" is [-] or [+].
OBJECT=CLEAR_PATTERN
CLEAR_PATTERN:TYPE=STRING
CLEAR_PATTERN:VALUE=2OP_ADD1

OBJECT=CH
CH:TYPE=STRING
CH:VALUE=

OBJECT=CHAR_POS
CHAR_POS:TYPE=INTEGER
CHAR_POS:VALUE=0

OBJECT=LAST_KIND
LAST_KIND:TYPE=STRING
LAST_KIND:VALUE=

OBJECT=EMIT_KIND
EMIT_KIND:TYPE=STRING
EMIT_KIND:VALUE=

OBJECT=EMIT_ARG
EMIT_ARG:TYPE=INTEGER
EMIT_ARG:VALUE=0

OBJECT=LAST_I
LAST_I:TYPE=INTEGER
LAST_I:VALUE=0

OBJECT=OPEN_ADDRESS
OPEN_ADDRESS:TYPE=INTEGER
OPEN_ADDRESS:VALUE=0

OBJECT=CLEAR_KEY
CLEAR_KEY:TYPE=STRING
CLEAR_KEY:VALUE=

OBJECT=NORM_KIND
NORM_KIND:TYPE=STRING
NORM_KIND:VALUE=

OBJECT=NORM_I
NORM_I:TYPE=INTEGER
NORM_I:VALUE=0

#
# COMPILER
#
# Branch bodies only call behaviours and pass values through fields: no [expr],
# $n or @RETURN inside an @IF branch, so the compiler also runs under pikhost.

OBJECT=INITIALIZE_TAPE
INITIALIZE_TAPE:TYPE=BEHAVIOUR
INITIALIZE_TAPE:CODE={TAPE^LOAD("$COMMON\bf_tape_30000.arr");}

OBJECT=INITIALIZE_JUMP_LOOKUP
INITIALIZE_JUMP_LOOKUP:TYPE=BEHAVIOUR
INITIALIZE_JUMP_LOOKUP:CODE={IS_ZERO^REMOVEALL();IS_NONZERO^REMOVEALL();IS_ZERO^ADD(1);IS_NONZERO^ADD(0);@LOOP("{IS_ZERO^ADD(0);IS_NONZERO^ADD(1);}",1,255,1);}

OBJECT=EMIT
EMIT:TYPE=BEHAVIOUR
EMIT:CODE={OPS^ADD($1);ARGS^ADD($2);OP_COUNT^INC();LAST_KIND^SET("");}

OBJECT=BUMP_LAST
BUMP_LAST:TYPE=BEHAVIOUR
BUMP_LAST:CODE={LAST_I^SET([OP_COUNT-1]);ARGS^CHANGEAT(LAST_I,[ARGS^GET(LAST_I)+EMIT_ARG]);}

OBJECT=EMIT_NEW_RUN
EMIT_NEW_RUN:TYPE=BEHAVIOUR
EMIT_NEW_RUN:CODE={EMIT^RUN(EMIT_KIND,EMIT_ARG);LAST_KIND^SET(EMIT_KIND);}

# $1 = op name, $2 = delta; extends the previous op when it is the same kind.
OBJECT=EMIT_RUN
EMIT_RUN:TYPE=BEHAVIOUR
EMIT_RUN:CODE={EMIT_KIND^SET($1);EMIT_ARG^SET($2);@IF("LAST_KIND","_","EMIT_KIND","{BUMP_LAST^RUN();}","{EMIT_NEW_RUN^RUN();}");}

OBJECT=EMIT_OPEN
EMIT_OPEN:TYPE=BEHAVIOUR
EMIT_OPEN:CODE={BRACKET_STACK^ADD(OP_COUNT);BRACKET_STACK_TOP^INC();EMIT^RUN("OP_JZ",0);}

OBJECT=CLOSE_AS_CLEAR
CLOSE_AS_CLEAR:TYPE=BEHAVIOUR
CLOSE_AS_CLEAR:CODE={OPS^REMOVEAT(LAST_I);ARGS^REMOVEAT(LAST_I);OPS^REMOVEAT(OPEN_ADDRESS);ARGS^REMOVEAT(OPEN_ADDRESS);OP_COUNT^DEC();OP_COUNT^DEC();EMIT^RUN("OP_CLEAR",0);}

OBJECT=CLOSE_AS_JUMP
CLOSE_AS_JUMP:TYPE=BEHAVIOUR
CLOSE_AS_JUMP:CODE={EMIT^RUN("OP_JNZ",[OPEN_ADDRESS-OP_COUNT]);ARGS^CHANGEAT(OPEN_ADDRESS,[OP_COUNT-1-OPEN_ADDRESS]);}

OBJECT=CLOSE_LOOP
CLOSE_LOOP:TYPE=BEHAVIOUR
CLOSE_LOOP:CODE={OPEN_ADDRESS^SET(BRACKET_STACK^GET(BRACKET_STACK_TOP));BRACKET_STACK^REMOVEAT(BRACKET_STACK_TOP);BRACKET_STACK_TOP^DEC();LAST_I^SET([OP_COUNT-1]);CLEAR_KEY^SET("");CLEAR_KEY^ADD([OP_COUNT-OPEN_ADDRESS]);CLEAR_KEY^ADD(OPS^GET(LAST_I));CLEAR_KEY^ADD([ARGS^GET(LAST_I)*ARGS^GET(LAST_I)]);@IF("CLEAR_KEY","_","CLEAR_PATTERN","{CLOSE_AS_CLEAR^RUN();}","{CLOSE_AS_JUMP^RUN();}");}

OBJECT=EMIT_CLOSE
EMIT_CLOSE:TYPE=BEHAVIOUR
EMIT_CLOSE:CODE={@IF("BRACKET_STACK_TOP","<","0","{VALID_PROGRAM^SET(0);ERROR_CODE^SET("UNMATCHED_CLOSE_AT_");ERROR_CODE^ADD(CHAR_POS);}","{CLOSE_LOOP^RUN();}");}

OBJECT=COMPILE_CHAR
COMPILE_CHAR:TYPE=BEHAVIOUR
COMPILE_CHAR:CODE={CH^SET(BF_CODE^GET($1));CHAR_POS^SET($1);@IF("CH","_","INCREMENT_VALUE_CHAR","{EMIT_RUN^RUN("OP_ADD",1);}","");@IF("CH","_","DECREMENT_VALUE_CHAR","{EMIT_RUN^RUN("OP_ADD",-1);}","");@IF("CH","_","INCREMENT_POINTER_CHAR","{EMIT_RUN^RUN("OP_MOVE",1);}","");@IF("CH","_","DECREMENT_POINTER_CHAR","{EMIT_RUN^RUN("OP_MOVE",-1);}","");@IF("CH","_","OPEN_LOOP_CHAR","{EMIT_OPEN^RUN();}","");@IF("CH","_","CLOSE_LOOP_CHAR","{EMIT_CLOSE^RUN();}","");@IF("CH","_","OUTPUT_CHAR","{EMIT^RUN("OP_OUT",0);}","");@IF("CH","_","INPUT_CHAR","{EMIT^RUN("OP_IN",0);}","");@IF("CH","_","DEBUG_CHAR","{EMIT^RUN("OP_DBG",0);}","");}

# Runs keep their raw (possibly negative) sum until here, so [-] is still visible
# to CLOSE_LOOP; afterwards OP_ADD takes 0..255 and OP_MOVE 0..TAPE_SIZE-1.
OBJECT=NORMALIZE_ADD
NORMALIZE_ADD:TYPE=BEHAVIOUR
NORMALIZE_ADD:CODE={ARGS^CHANGEAT(NORM_I,[ARGS^GET(NORM_I)%256+256%256]);}

OBJECT=NORMALIZE_MOVE
NORMALIZE_MOVE:TYPE=BEHAVIOUR
NORMALIZE_MOVE:CODE={ARGS^CHANGEAT(NORM_I,[ARGS^GET(NORM_I)%TAPE_SIZE+TAPE_SIZE%TAPE_SIZE]);}

OBJECT=NORMALIZE_OP
NORMALIZE_OP:TYPE=BEHAVIOUR
NORMALIZE_OP:CODE={NORM_I^SET($1);NORM_KIND^SET(OPS^GET($1));@IF("NORM_KIND","_","ADD_OP_NAME","{NORMALIZE_ADD^RUN();}","");@IF("NORM_KIND","_","MOVE_OP_NAME","{NORMALIZE_MOVE^RUN();}","");}

OBJECT=PREPROCESS_CODE
PREPROCESS_CODE:TYPE=BEHAVIOUR
PREPROCESS_CODE:CODE={VALID_PROGRAM^SET(1);ERROR_CODE^SET("");BRACKET_STACK^REMOVEALL();BRACKET_STACK_TOP^SET(-1);OPS^REMOVEALL();ARGS^REMOVEALL();OP_COUNT^SET(0);LAST_KIND^SET("");@LOOP("{COMPILE_CHAR^RUN(_I_);}",0,PROGRAM_LENGTH,1);EMIT^RUN("OP_END",0);EMIT^RUN("OP_HALT",0);@LOOP("{NORMALIZE_OP^RUN(_I_);}",0,OP_COUNT,1);@IF("BRACKET_STACK_TOP",">_","0","{VALID_PROGRAM^SET(0);ERROR_CODE^SET("UNMATCHED_OPEN_AT_OP_");ERROR_CODE^ADD(BRACKET_STACK^GET(BRACKET_STACK_TOP));}","");}

#
# VM OPERATIONS
#
# Each one is called as *OPNAME^RUN() with IP pointing at it; RUN_CHUNK
# increments IP afterwards. Ops that end the slice push STEPS to STEP_BUDGET.

OBJECT=OP_ADD
OP_ADD:TYPE=BEHAVIOUR
OP_ADD:CODE={TAPE^CHANGEAT(TP,[TAPE^GET(TP)+ARGS^GET(IP)%256]);}

OBJECT=OP_MOVE
OP_MOVE:TYPE=BEHAVIOUR
OP_MOVE:CODE={TP^SET([TP+ARGS^GET(IP)%TAPE_SIZE]);}

OBJECT=OP_CLEAR
OP_CLEAR:TYPE=BEHAVIOUR
OP_CLEAR:CODE={TAPE^CHANGEAT(TP,0);}

OBJECT=OP_JZ
OP_JZ:TYPE=BEHAVIOUR
OP_JZ:CODE={IP^SET([IS_ZERO^GET(TAPE^GET(TP))*ARGS^GET(IP)+IP]);}

OBJECT=OP_JNZ
OP_JNZ:TYPE=BEHAVIOUR
OP_JNZ:CODE={IP^SET([IS_NONZERO^GET(TAPE^GET(TP))*ARGS^GET(IP)+IP]);}

OBJECT=OP_OUT
OP_OUT:TYPE=BEHAVIOUR
OP_OUT:CODE={RENDER_REQUESTED^SET(1);STEPS^SET(STEP_BUDGET);HALTED^SET(1);RESUME_IP^SET([IP+1]);IP^SET([OP_COUNT-2]);}

OBJECT=OP_IN
OP_IN:TYPE=BEHAVIOUR
OP_IN:CODE={@INT("KEY_MASK",0);@IF(KEYBOARD^ISKEYDOWN("Z"),"_",TRUE,"{KEY_MASK^ADD(128);}","");@IF(KEYBOARD^ISKEYDOWN("X"),"_",TRUE,"{KEY_MASK^ADD(64);}","");@IF(KEYBOARD^ISKEYDOWN("ENTER"),"_",TRUE,"{KEY_MASK^ADD(32);}","");@IF(KEYBOARD^ISKEYDOWN("SPACE"),"_",TRUE,"{KEY_MASK^ADD(16);}","");@IF(KEYBOARD^ISKEYDOWN("UP"),"_",TRUE,"{KEY_MASK^ADD(8);}","");@IF(KEYBOARD^ISKEYDOWN("DOWN"),"_",TRUE,"{KEY_MASK^ADD(4);}","");@IF(KEYBOARD^ISKEYDOWN("LEFT"),"_",TRUE,"{KEY_MASK^ADD(2);}","");@IF(KEYBOARD^ISKEYDOWN("RIGHT"),"_",TRUE,"{KEY_MASK^ADD(1);}","");TAPE^CHANGEAT(TP,KEY_MASK);}

OBJECT=OP_DBG
OP_DBG:TYPE=BEHAVIOUR
OP_DBG:CODE={LAST_DEBUG_VALUE^SET(TAPE^GET(TP));}

# Placed after OP_END. OP_OUT parks IP here so the rest of the chunk does
# nothing; RUN_SLICE then continues from RESUME_IP.
OBJECT=OP_HALT
OP_HALT:TYPE=BEHAVIOUR
OP_HALT:CODE={IP^DEC();}

# The end of the program; IP stays on it.
OBJECT=OP_END
OP_END:TYPE=BEHAVIOUR
OP_END:CODE={RUNNING^SET(0);STEPS^SET(STEP_BUDGET);IP^DEC();}

#
# FRAME LOOP
#
# CLSBFOBJ is declared in the episode (bf.cnv), so this instance resolves names
# in the episode and the application only. BF_SCREEN is created by the scene and
# lives there, out of reach. The scene owns the timer and the renderer instead:
# it calls TICK every frame and reads the video memory through GET_CELL.

OBJECT=GET_CELL
GET_CELL:TYPE=BEHAVIOUR
GET_CELL:CODE={@RETURN(TAPE^GET($1));}

# A fixed @LOOP is much cheaper per op than a @WHILE condition, so ops run in
# chunks of 64 and the budget is only checked between chunks.
OBJECT=RUN_CHUNK
RUN_CHUNK:TYPE=BEHAVIOUR
RUN_CHUNK:CODE={@LOOP("{OPNAME^SET(OPS^GET(IP));*OPNAME^RUN();IP^INC();}",0,64,1);STEPS^ADD(64);}

OBJECT=RUN_SLICE
RUN_SLICE:TYPE=BEHAVIOUR
RUN_SLICE:CODE={STEPS^SET(0);HALTED^SET(0);@WHILE("STEPS","<","STEP_BUDGET","{RUN_CHUNK^RUN();}");@IF("HALTED","_","1","{IP^SET(RESUME_IP);}","");}

# Runs until the next "." (or the step budget) and returns 1 when the scene should redraw.
OBJECT=TICK
TICK:TYPE=BEHAVIOUR
TICK:CODE={RENDER_REQUESTED^SET(0);@IF("RUNNING","_","1","{RUN_SLICE^RUN();}","");@RETURN(RENDER_REQUESTED);}

OBJECT=IS_RUNNING
IS_RUNNING:TYPE=BEHAVIOUR
IS_RUNNING:CODE={@RETURN(RUNNING);}

OBJECT=START_BF
START_BF:TYPE=BEHAVIOUR
START_BF:CODE={RUNNING^SET(0);RENDER_REQUESTED^SET(0);IP^SET(0);TP^SET(0);INITIALIZE_TAPE^RUN();INITIALIZE_JUMP_LOOKUP^RUN();PREPROCESS_CODE^RUN();DEBUG_LOG^SET(ERROR_CODE);@IF("VALID_PROGRAM","_","1","{RUNNING^SET(1);}","");}

OBJECT=STOP_BF
STOP_BF:TYPE=BEHAVIOUR
STOP_BF:CODE={RUNNING^SET(0);}

OBJECT=CONSTRUCTOR
CONSTRUCTOR:TYPE=BEHAVIOUR
CONSTRUCTOR:CODE={BF_CODE^SET($2);START_BF^RUN();}

OBJECT=DESTRUCTOR
DESTRUCTOR:TYPE=BEHAVIOUR
DESTRUCTOR:CODE={STOP_BF^RUN();}
